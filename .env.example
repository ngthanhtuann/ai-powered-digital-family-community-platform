# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.
# File mẫu chỉ chứa tên biến; POSTGRES_PASSWORD, JWT_SECRET phải được đặt trước khi chạy Docker.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Khi chạy backend ngoài Docker/IDE, cung cấp thêm SPRING_DATASOURCE_PASSWORD cho DB đó.
# SPRING_DATASOURCE_PASSWORD=
# Cổng PostgreSQL mở ra máy (chỉ 127.0.0.1), mặc định 5432. Máy đã cài PostgreSQL chiếm 5432 thì đặt cổng khác,
# ví dụ 5433. Backend chạy trong Docker không bị ảnh hưởng.
# Khi chạy backend bằng IDE, cập nhật SPRING_DATASOURCE_URL theo cổng đã chọn.
# POSTGRES_HOST_PORT=
CORS_ALLOWED_ORIGINS=
# Địa chỉ backend mà web (cổng 3000) gọi tới; đổi thì phải build lại: docker compose up -d --build frontend
NEXT_PUBLIC_API_BASE_URL=

# Khóa ký JWT (SCRUM-35): bắt buộc, tối thiểu 32 ký tự, mỗi máy tự sinh, không đưa vào Git.
# Sinh nhanh: openssl rand -base64 48
# Chạy backend bằng IDE thì đặt cùng biến này trong cấu hình Run của IDE.
JWT_SECRET=

# Tài khoản SYSTEM_ADMIN đầu tiên (BR-AUTH-20), chỉ tạo khi hệ thống chưa có quản trị viên. Để trống thì bỏ qua.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Khóa Gemini API cho chỉ mục AI (SCRUM-41, adr-ai-spike.md). Để trống thì bỏ qua lập chỉ mục.
# Gói miễn phí: chỉ dùng dữ liệu giả (privacy.md).
GEMINI_API_KEY=

# Số lần gọi /auth/refresh tối đa mỗi phút cho mỗi địa chỉ IP.
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=

# Thư mục lưu tệp tải lên khi chạy backend ngoài Docker (Docker Compose đã tự đặt). Nên trỏ ra ngoài repo;
# để trống thì dùng ./uploads (đã có trong .gitignore).
# MEDIA_STORAGE_PATH=
