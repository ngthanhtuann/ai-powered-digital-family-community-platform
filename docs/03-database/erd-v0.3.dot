digraph ERD {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=18, labelloc=t, label="ERD tổng hợp FamilyConnect v0.3 (nháp)\nNét liền: khóa ngoại trong cùng module. Nét đứt: tham chiếu logic giữa các module (cột UUID có index, không có FK). Mọi bảng nghiệp vụ: created_by, updated_by tham chiếu users (không vẽ).", nodesep=0.35, ranksep=1.2, splines=true, pad=0.4];
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
  subgraph cluster_0 { label="Auth và quản trị (auth, admin)  ·  TV1 Tuấn"; style="rounded,filled"; fillcolor="#FAF7F0"; color="#B3A0C8"; penwidth=2; fontname="DejaVu Sans"; fontsize=13;
    users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#B3A0C8" ALIGN="CENTER"><B>users</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B> <FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">+ 10 cột khác</FONT></TD></TR></TABLE>>];
    role [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#B3A0C8" ALIGN="CENTER"><B>role</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B> <FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">+ 3 cột khác</FONT></TD></TR></TABLE>>];
    user_role [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#B3A0C8" ALIGN="CENTER"><B>user_role</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B> <FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id <FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_id">role_id <FONT POINT-SIZE="9">FK</FONT></TD></TR></TABLE>>];
    refresh_token [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#B3A0C8" ALIGN="CENTER"><B>refresh_token</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B> <FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id <FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">+ 3 cột khác</FONT></TD></TR></TABLE>>];
    member_verification [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#B3A0C8" ALIGN="CENTER"><B>member_verification</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B> <FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id <FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="family_id">family_id <FONT POINT-SIZE="9"><I>logic</I></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="branch_id">branch_id <FONT POINT-SIZE="9"><I>logic</I></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reviewed_by">reviewed_by <FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">+ 7 cột khác</FONT></TD></TR></TABLE>>];
    audit_log [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#B3A0C8" ALIGN="CENTER"><B>audit_log</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B> <FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actor_user_id">actor_user_id <FONT POINT-SIZE="9"><I>logic</I></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="family_id">family_id <FONT POINT-SIZE="9"><I>logic</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">+ 6 cột khác</FONT></TD></TR></TABLE>>];
