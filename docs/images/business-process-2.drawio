ight="62" as="geometry" /></mxCell><mxCell id="b5" value="Tạo person; ghi audit log;&lt;br&gt;báo module ai cập nhật embedding" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="625" y="699" width="250" height="62" as="geometry" /></mxCell><mxCell id="b6" value='Chọn con, "Thêm cha/mẹ": vai trò&lt;br&gt;FATHER/MOTHER, loại BIOLOGICAL /&lt;br&gt;ADOPTED / STEP' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="325" y="813" width="250" height="74" as="geometry" /></mxCell><mxCell id="b7" value="Cùng gia đình, đủ cha/mẹ&lt;br&gt;ruột, không vòng lặp,&lt;br&gt;ngày sinh hợp lý?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="635" y="915" width="230" height="110" as="geometry" /></mxCell><mxCell id="b7e" value="409 GEN_005: đã đủ cha và mẹ ruột&lt;br&gt;409 GEN_006: vòng lặp tổ tiên&lt;br&gt;409 GEN_007: cha/mẹ sinh sau con&lt;br&gt;409 GEN_008: trùng người/quan hệ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=13;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="920" y="924" width="250" height="92" as="geometry" /></mxCell><mxCell id="b8" value="Tạo parent_child;&lt;br&gt;ghi audit log, làm mới cây" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="625" y="1059" width="250" height="62" as="geometry" /></mxCell><mxCell id="b9" value="Thành viên xem cây gia phả&lt;br&gt;đã cập nhật (UC-GEN-06)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="25" y="1179" width="250" height="62" as="geometry" 