<mxfile host="app.diagrams.net" type="device"><diagram id="business-process-3" name="Tạo sự kiện, RSVP và nhắc nhở"><mxGraphModel dx="1490" dy="2380" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1490" pageHeight="2380" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="lane0" value="Thành viên" style="swimlane;horizontal=1;startSize=50;html=1;collapsible=0;fillColor=#E2E8F0;swimlaneFillColor=#F5F9FF;strokeColor=#94A3B8;fontStyle=1;fontSize=15;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="300" height="2380" as="geometry" /></mxCell><mxCell id="lane1" value="Trưởng chi (BRANCH_ADMIN)" style="swimlane;horizontal=1;startSize=50;html=1;collapsible=0;fillColor=#E2E8F0;swimlaneFillColor=#FFFAF0;strokeColor=#94A3B8;fontStyle=1;fontSize=15;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="300" y="0" width="300" height="2380" as="geometry" /></mxCell><mxCell id="lane2" value="Hệ thống" style="swimlane;horizontal=1;startSize=50;html=1;collapsible=0;fillColor=#E2E8F0;swimlaneFillColor=#F3FCF5;strokeColor=#94A3B8;fontStyle=1;fontSize=15;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="600" y="0" width="590" height="2380" as="geometry" /></mxCell><mxCell id="lane3" value="AI Service" style="swimlane;horizontal=1;startSize=50;html=1;collapsible=0;fillColor=#E2E8F0;swimlaneFillColor=#FFF5F8;strokeColor=#94A3B8;fontStyle=1;fontSize=15;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1190" y="0" width="300" height="2380" as="geometry" /></mxCell><mxCell id="head0" value="A. Tạo sự kiện (UC-EVT-01, BR-EVT-01, BR-EVT-06)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="10" y="110" width="1470" height="40" as="geometry" /></mxCell><mxCell id="head1" value="B. RSVP (UC-EVT-02, BR-EVT-02): mỗi người tối đa một RSVP đang hoạt động cho một sự kiện" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="10" y="950" width="1470" height="40" as="geometry" /></mxCell><mxCell id="head2" value="C. Nhắc nhở (UC-EVT-05, BR-EVT-05): luồng riêng do hệ thống tự chạy, nhắc 24 giờ và 1 giờ trước start_at" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="10" y="1670" width="1470" height="40" as="geometry" /></mxCell><mxCell id="c1" value="Thành viên đã xác minh&lt;br&gt;chọn tạo sự kiện" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="25" y="219" width="250" height="62" as="geometry" /></mxCell><mxCell id="c1b" value="Trưởng chi / Quản trị hệ thống&lt;br&gt;chọn tạo sự kiện" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="325" y="219" width="250" height="62" as="geometry" /></mxCell><mxCell id="c2" value="Nhập thông tin sự kiện" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="25" y="339" width="250" height="62" as="geometry" /></mxCell><mxCell id="c3" value="Có quyền tạo?&lt;br&gt;(BR-EVT-01)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="635" y="446" width="230" height="88" as="geometry" /></mxCell><mxCell id="c3e" value="403 PERM_001" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=13;fontColor=#7F1D1D;" vertex="1" parent="1